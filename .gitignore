# Build artifacts
build/
build[0-9]*/
build_*/
build-*/
cmake-build-*/
out/

# CI benchmark output (see .github/workflows/ci.yml's benchmarks job)
bench-output/

# IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Kiro IDE internal execution-tracking state (chat session IDs,
